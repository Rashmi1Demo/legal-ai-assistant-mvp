# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/legal_ai_db

# AI Provider
# auto = Claude when API key is available; otherwise Ollama.
LLM_PROVIDER=auto

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_URL=https://api.anthropic.com/v1/messages

# Local Ollama fallback
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:3b

# OCR - Local Windows development only
TESSERACT_CMD=
POPPLER_PATH=